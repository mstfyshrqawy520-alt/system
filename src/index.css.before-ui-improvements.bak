@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-tajawal: 'Cairo', 'Tajawal', sans-serif;
}

html,
body,
#root {
  min-width: 0;
  width: 100%;
}

body {
  margin: 0;
  overflow-x: hidden;
  font-family: var(--font-tajawal), -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: #0b1220;
  color: #f8fafc;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #0f172a;
}
::-webkit-scrollbar-thumb {
  background: #1e293b;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #334155;
}

button,
a,
select,
input,
textarea {
  touch-action: manipulation;
}

/* RTL Input alignment */
[dir='rtl'] input,
[dir='rtl'] textarea,
[dir='rtl'] select {
  text-align: right;
}

/* Custom Focus States */
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: #0ea5e9 !important;
  box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.2);
}

/* Animation utilities */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.2s ease-out forwards;
}

/* Purchase order modal: always open at the top-center of the viewport. */
.modal-top-viewport,
.po-modal-viewport {
  position: fixed !important;
  inset: 0 !important;
  z-index: 9999 !important;
  display: flex !important;
  align-items: flex-start !important;
  justify-content: center !important;
  padding-top: 24px !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
}

/* Printer-safe A4 Print Styles */
@media print {
  @page {
    size: A4 portrait;
    margin: 5mm;
  }

  html,
  body,
  #root {
    width: 100% !important;
    height: auto !important;
    min-width: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #ffffff !important;
    color: #0f172a !important;
  }

  /* اطبع المستند المختار فقط، وأزل تخطيط التطبيق من حساب الصفحات. */
  body * {
    visibility: hidden !important;
  }

  body:has(.print-container) > #root {
    display: contents !important;
  }

  body:has(.print-container) #root *:has(.print-container) {
    display: contents !important;
  }

  body:has(.print-container) #root *:has(.print-container) > *:not(:has(.print-container)) {
    display: none !important;
  }

  .print-container,
  .print-container * {
    visibility: visible !important;
    font-family: 'Cairo', var(--font-tajawal), 'Tajawal', 'Noto Sans Arabic', 'Arial', sans-serif !important;
    font-weight: 800 !important;
    color: #000000 !important;
    -webkit-text-fill-color: #000000 !important;
    text-rendering: optimizeLegibility;
  }

  .print-container {
    position: absolute !important;
    inset: auto !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: auto !important;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    min-height: 0 !important;
    max-height: none !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: #ffffff !important;
    page-break-after: auto !important;
    break-after: auto !important;
  }

  .print-container > div {
    position: static !important;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    max-height: none !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: #ffffff !important;
  }

  .print-document {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    min-height: 0 !important;
    max-height: none !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: #ffffff !important;
    color: #000000 !important;
    page-break-inside: auto !important;
    break-inside: auto !important;
    page-break-after: auto !important;
    break-after: auto !important;
  }

  .document-logo {
    display: block !important;
    height: 52px !important;
    width: auto !important;
    object-fit: contain !important;
    margin: 0 auto 3px !important;
  }

  nav,
  header,
  aside,
  button,
  .print\:hidden {
    display: none !important;
  }

  .print\:bg-white {
    background-color: #ffffff !important;
  }

  .print\:text-slate-900 {
    color: #000000 !important;
  }

  .print\:p-0 {
    padding: 0 !important;
  }

  .print-document table {
    width: 100% !important;
    margin-top: 4px !important;
    max-width: 100% !important;
    table-layout: fixed;
    page-break-inside: auto;
    font-size: 9px;
  }

  .print-document th,
  .print-document td {
    padding: 3px !important;
    line-height: 1.1 !important;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .print-document .mt-6 {
    margin-top: 6px !important;
  }

  .print-document tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }

  .print-document thead {
    display: table-header-group;
  }

  .print-document tfoot {
    display: table-footer-group;
  }
}


@media (max-width: 640px) {
  .procurement-reference-page {
    margin-inline: -0.75rem;
    padding: 1rem 0.75rem 1.5rem;
    min-height: calc(100vh - 4.5rem);
  }

  .procurement-reference-page table {
    font-size: 0.68rem;
  }

  .procurement-reference-page thead th,
  .procurement-reference-page tbody td {
    padding-inline: 0.5rem;
  }
}

/* User accessibility preferences */
html.reduce-motion *, html.reduce-motion *::before, html.reduce-motion *::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
  scroll-behavior: auto !important;
}
html[data-density="compact"] .space-y-6 {
  row-gap: 0.9rem !important;
}
html[data-density="compact"] .space-y-4 {
  row-gap: 0.55rem !important;
}


/* Reference theme for the Procurement Manager workspace. */
.procurement-reference-page {
  --procurement-bg: #070b16;
  --procurement-panel: rgba(13, 23, 40, 0.9);
  --procurement-panel-soft: rgba(17, 29, 49, 0.72);
  --procurement-line: rgba(70, 105, 143, 0.52);
  --procurement-cyan: #21d4ff;
  --procurement-cyan-soft: rgba(33, 212, 255, 0.12);
  --procurement-green: #39d98a;
  position: relative;
  isolation: isolate;
  min-height: calc(100vh - 5.5rem);
  margin-inline: -1.5rem;
  padding: 1.35rem 1.5rem 2rem;
  color: #d7e6f7;
  background:
    radial-gradient(circle at 87% 0%, rgba(18, 117, 163, 0.16), transparent 34rem),
    linear-gradient(180deg, #090e1c 0%, var(--procurement-bg) 55%, #050811 100%);
}

.procurement-reference-page::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.25;
  background-image: linear-gradient(rgba(87, 151, 187, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(87, 151, 187, 0.04) 1px, transparent 1px);
  background-size: 32px 32px;
  mask-image: linear-gradient(to bottom, black, transparent 86%);
}

.procurement-reference-page h1,
.procurement-reference-page h2,
.procurement-reference-page h3 {
  color: #e8f6ff;
  letter-spacing: -0.01em;
}

.procurement-reference-page h1 {
  text-shadow: 0 0 20px rgba(33, 212, 255, 0.14);
}

.procurement-reference-page .rounded-2xl.border,
.procurement-reference-page .rounded-xl.border,
.procurement-reference-page .rounded-lg.border {
  border-color: var(--procurement-line);
  background-color: var(--procurement-panel);
  box-shadow: 0 16px 42px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(153, 217, 255, 0.05);
}

.procurement-reference-page table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
  color: #d2e0ee;
  background: rgba(7, 13, 25, 0.62);
}

.procurement-reference-page thead {
  background: linear-gradient(180deg, rgba(18, 45, 70, 0.9), rgba(12, 28, 49, 0.94));
}

.procurement-reference-page thead th {
  border-bottom: 1px solid rgba(33, 212, 255, 0.28);
  color: #73ddff;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.procurement-reference-page tbody tr {
  background: rgba(12, 21, 36, 0.72);
  border-bottom: 1px solid rgba(66, 96, 129, 0.3);
}

.procurement-reference-page tbody tr:nth-child(even) {
  background: rgba(18, 30, 48, 0.62);
}

.procurement-reference-page tbody tr:hover {
  background: rgba(23, 68, 92, 0.34);
}

.procurement-reference-page tbody td {
  border-bottom: 1px solid rgba(66, 96, 129, 0.28);
  font-size: 0.72rem;
}

.procurement-reference-page input,
.procurement-reference-page select,
.procurement-reference-page textarea {
  border-color: rgba(76, 116, 153, 0.68) !important;
  background-color: rgba(8, 17, 31, 0.9) !important;
  color: #e2f0fc !important;
  box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.24);
}

.procurement-reference-page input::placeholder,
.procurement-reference-page textarea::placeholder {
  color: #7290a9;
}

.procurement-reference-page input:focus,
.procurement-reference-page select:focus,
.procurement-reference-page textarea:focus {
  border-color: var(--procurement-cyan) !important;
  box-shadow: 0 0 0 3px rgba(33, 212, 255, 0.13), 0 0 18px rgba(33, 212, 255, 0.08);
}

.procurement-reference-page .text-cyan-400,
.procurement-reference-page .text-cyan-300 {
  color: var(--procurement-cyan) !important;
}

.procurement-reference-page .bg-slate-900\/80,
.procurement-reference-page .bg-slate-900\/60,
.procurement-reference-page .bg-slate-800\/60 {
  background-color: var(--procurement-panel-soft);
}

.procurement-reference-page .border-slate-700,
.procurement-reference-page .border-slate-800,
.procurement-reference-page .border-slate-700\/80 {
  border-color: var(--procurement-line);
}

.procurement-reference-page .shadow-lg,
.procurement-reference-page .shadow-xl,
.procurement-reference-page .shadow-2xl {
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.28), 0 0 22px rgba(33, 212, 255, 0.04);
}

.procurement-reference-page [role='dialog'] {
  border: 1px solid rgba(33, 212, 255, 0.42);
  background: linear-gradient(180deg, rgba(15, 29, 49, 0.98), rgba(7, 13, 26, 0.98));
  box-shadow: 0 26px 80px rgba(0, 0, 0, 0.56), 0 0 32px rgba(33, 212, 255, 0.1);
}

.procurement-reference-page .procurement-reference-toolbar {
  border: 1px solid rgba(33, 212, 255, 0.2);
  background: rgba(9, 20, 36, 0.82);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.procurement-reference-page .procurement-reference-kpi {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(67, 112, 151, 0.62);
  background: linear-gradient(145deg, rgba(19, 39, 62, 0.94), rgba(9, 19, 34, 0.9));
  box-shadow: 0 15px 32px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(105, 211, 255, 0.08);
}

.procurement-reference-page .procurement-reference-kpi::after {
  content: '';
  position: absolute;
  top: -2.5rem;
  left: -2.5rem;
  width: 7rem;
  height: 7rem;
  border-radius: 999px;
  background: rgba(33, 212, 255, 0.08);
  filter: blur(2px);
}

@media (max-width: 768px) {
  .procurement-reference-page {
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
}

