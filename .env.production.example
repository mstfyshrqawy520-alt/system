# انسخ هذا الملف إلى .env على خادم الإنتاج ولا تضعه داخل Git.
APP_NAME="Al-Ashbiliya Procurement Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
# Cloudflare/Nginx are the only reverse proxies in front of Laravel.
TRUSTED_PROXIES=*
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_ashbiliya_procurement
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
VITE_APP_NAME="Al-Ashbiliya Procurement Management System"
VITE_API_BASE_URL=https://api.example.com/api/v1

VITE_NOTIFICATIONS_STREAM_TIMEOUT=120

# Production browser security headers.
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
