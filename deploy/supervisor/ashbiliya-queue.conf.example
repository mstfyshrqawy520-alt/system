[program:ashbiliya-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/al-ashbiliya/artisan queue:work --sleep=3 --tries=3 --timeout=90
directory=/var/www/al-ashbiliya
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/al-ashbiliya/storage/logs/queue-worker.log
stopwaitsecs=3600
