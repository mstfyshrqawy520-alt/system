dy></Table>{!filteredAccounts.length && <div className="py-8 text-center text-sm text-slate-500">{accounts.length ? 'لا توجد نتائج مطابقة للبحث الحالي.' : 'لا توجد حسابات موردين متاحة.'}</div>}</Card>
