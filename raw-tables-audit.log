ll><TableCell className="font-mono">{invoice.purchase_order?.po_number || '—'}</TableCell><TableCell>{invoice.invoice_date}</TableCell><TableCell className="font-mono">{money(invoice.amount)}</TableCell><TableCell className="font-mono text-emerald-300">{money(invoice.paid_amount)}</TableCell><TableCell className="font-mono text-amber-300">{money(invoice.outstanding_amount)}</TableCell><TableCell>{invoice.status === 'PAID' ? 'مدفوعة' : invoice.status === 'PARTIALLY_PAID' ? 'جزئية' : invoice.status === 'OPEN' ? 'مفتوحة' : invoice.status}</TableCell></TableRow>)}</TableBody></Table></div><div><h3 className="mb-2 text-sm font-black text-slate-200">سجل الدفعات</h3><Table><TableHeader><TableRow><TableHead>رقم الدفعة</TableHead><TableHead>التاريخ</TableHead><TableHead>طريقة الدفع</TableHead><TableHead>المبلغ</TableHead><TableHead>الموزع على الفواتير</TableHead><TableHead>الزيادة</TableHead><TableHead>المرجع</TableHead></TableRow></TableHeader><TableBody>{selected.payments.map(payment => <TableRow key={payment.id}><TableCell className="font-mono text-cyan-300">{payment.payment_number}</TableCell><TableCell>{payment.payment_date}</TableCell><TableCell>{paymentMethods[payment.payment_method] || payment.payment_method}</TableCell><TableCell className="font-mono text-emerald-300">{money(payment.amount)}</TableCell><TableCell className="font-mono">{payment.allocations?.length ? <div className="space-y-1">{payment.allocations.map((allocation) => <div key={allocation.id} className="whitespace-nowrap text-[11px]">فاتورة {allocation.invoice?.invoice_number || `#${allocation.supplier_invoice_id}`}: <span className="font-bold text-cyan-300">{money(allocation.amount)}</span></div>)}</div> : money(payment.allocated_amount)}</TableCell><TableCell className="font-mono text-rose-300">{money(payment.overpayment_amount)}</TableCell><TableCell>{payment.reference_number || '—'}</TableCell></TableRow>)}</TableBody></Table>{!selected.payments.length && <div className="py-6 text-center text-sm text-slate-500">لا توجد دفعات مسجلة لهذا المورد.</div>}</div></Card>}
